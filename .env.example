# Database
DATABASE_URL="postgresql://leads:leads_secret@localhost:5432/leads_db"

# PostgreSQL (used by docker-compose)
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads_secret
POSTGRES_DB=leads_db

# App
NODE_ENV=development

# Auth (next-auth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-char-secret"
AUTH_URL="http://localhost:3000"

# Scraping config
# Rate limit delay in ms between requests (default: 2000)
SCRAPE_DELAY_MS=2000

# Max results per search job — overridden per plan at runtime
SCRAPE_MAX_RESULTS=50
