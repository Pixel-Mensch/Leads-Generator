# Required app runtime
# Used by Prisma and the app server.
DATABASE_URL="postgresql://leads:leads_secret@localhost:5432/leads_db"

# App
NODE_ENV=development

# Auth (next-auth v5 / Auth.js)
# Required for JWT / cookie signing.
# Generate with one of:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# Local PostgreSQL container (only used by docker-compose)
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads_secret
POSTGRES_DB=leads_db

# Optional scraper tuning
# Rate limit delay in ms between requests (default: 2000).
SCRAPE_DELAY_MS=2000

# Optional absolute hard cap across all plans. Keep this >= the highest plan limit.
SCRAPE_MAX_RESULTS=500
