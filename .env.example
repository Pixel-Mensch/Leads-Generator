# Database
DATABASE_URL="postgresql://leads:leads_secret@localhost:5432/leads_db"

# PostgreSQL (used by docker-compose)
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads_secret
POSTGRES_DB=leads_db

# App
NODE_ENV=development

# Scraping config
# Rate limit delay in ms between requests (default: 1500)
SCRAPE_DELAY_MS=1500

# Max results per search job (default: 50)
SCRAPE_MAX_RESULTS=50
